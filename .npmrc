# =========================================================================
# HARDENING LAYER 1: Lifecycle Script Block
# =========================================================================
# Disables the automatic execution of 'preinstall', 'install', and 'postinstall' 
# scripts embedded inside third-party dependencies. This blocks the most common 
# vector for npm-based malware (malicious shell execution upon downloading).
ignore-scripts=true

# =========================================================================
# HARDENING LAYER 2: Deterministic Version Pinning
# =========================================================================
# Forces the CLI to save exact version strings (e.g., "1.4.2") instead of 
# using mutable ranges (e.g., "^1.4.2") when developers run `npm install <pkg>`.
# This ensures that local development files tightly align with the lockfile.
save-exact=true

# =========================================================================
# HARDENING LAYER 7: Supply Chain Cooldown Gate
# =========================================================================
# Blocks the installation of any package version (including transitive sub-dependencies) 
# that was published to a registry less than 7 days ago. This heavily mitigates 
# "smash-and-grab" supply chain exploits before public security teams can yank them.
# NOTE: Requires npm CLI v11.10.0 or higher. The unit is strictly integer DAYS.
min-release-age=7

# EMERGENCY BYPASS FOR INTERNAL PATCHES / ZERO-DAY FIXES:
# If you must install a brand-new package or internal update that is < 7 days old, 
# bypass this gate locally or in CI by passing the 0-day override flag:
#   npm install --min-release-age=0 <package-name>
#   npm ci --min-release-age=0

# =========================================================================
# GLOBAL REGISTRY FALLBACK & AUTHENTICATION BOUNDARIES
# =========================================================================
# The catch-all default registry for public, unscoped dependencies (e.g., react, express).
registry=https://registry.npmjs.org/

# Prevents npm from universally broadcasting your private Verdaccio authorization tokens/headers 
# to the public npmjs.org registry during routine installations.
always-auth=false